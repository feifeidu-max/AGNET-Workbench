# ===== Hermes Studio (WebUI) =====
PORT=6060
PREVIEW_FRONTEND_PORT=8651
XAI_OAUTH_PORT=56121
WEBUI_IMAGE=hermes-web-ui:latest
WEBUI_CONTAINER_NAME=hermes-webui
HERMES_DATA_DIR=./hermes_data
HERMES_WEB_UI_AUTH_JWT_EXPIRES_IN=30d

# ===== LLM Wiki (知识库，可选；启用: docker compose --profile kb up -d) =====
WIKI_IMAGE=llm-wiki:latest
WIKI_CONTAINER_NAME=llm-wiki
WIKI_PORT=19828
WIKI_DATA_DIR=./wiki_data

# WebUI 与 LLM Wiki 必须共用同一个令牌。生产环境务必修改！
LLM_WIKI_API_TOKEN=change-me-in-prod

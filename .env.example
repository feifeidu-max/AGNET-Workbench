# ===== Hermes Studio (WebUI) =====
PORT=6060
PREVIEW_FRONTEND_PORT=8651
XAI_OAUTH_PORT=56121
WEBUI_IMAGE=hermes-web-ui:latest
WEBUI_CONTAINER_NAME=hermes-webui
HERMES_DATA_DIR=./hermes_data
HERMES_WEB_UI_AUTH_JWT_EXPIRES_IN=30d

# ===== LLM Wiki (知识库，可选；启用: docker compose --profile kb up -d) =====
WIKI_IMAGE=llm-wiki:latest
WIKI_CONTAINER_NAME=llm-wiki
WIKI_PORT=19828
WIKI_DATA_DIR=./wiki_data

# WebUI 与 LLM Wiki 必须共用同一个令牌。生产环境务必修改！
LLM_WIKI_API_TOKEN=change-me-in-prod

# LLM 语义富化（可选）：知识库的语义摘要/主题分类/关系抽取与检索重排
# 使用与 Hermes 相同的 opencode/mimo 模型时，保持两处一致
LLM_WIKI_LLM_PROVIDER=custom
LLM_WIKI_LLM_MODEL=mimo-v2.5
LLM_WIKI_LLM_API_KEY=
LLM_WIKI_LLM_CUSTOM_ENDPOINT=https://opencode.ai/zen/go/v1
LLM_WIKI_LLM_MAX_TOKENS=65536

# 微信多成员网关（可选）：每个成员独立 bot，需本机代理访问 iLink
# 若本机使用 Clash 等代理，需放行 127.0.0.1
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897
NO_PROXY=127.0.0.1,localhost,::1

# Hermes 对话模型（opencode-go/mimo-v2.5）
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

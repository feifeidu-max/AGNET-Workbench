# LLM Wiki — headless API server (no GUI) for container deployment.
#
# LLM Wiki is a Tauri application. Even in headless mode (LLM_WIKI_HEADLESS=1)
# it links WebKit, so we install the GTK/WebKit dev + runtime libraries. The
# Rust compile is heavy and the base distro is assumed to be Debian bookworm;
# adjust the apt packages if your base differs. See DOCKER.md for troubleshooting.

# ---------- Build stage ----------
FROM node:24-bookworm-slim AS build

# Rust toolchain
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates build-essential pkg-config libssl-dev \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable \
    && . "$HOME/.cargo/env" && rustc --version && cargo --version
ENV PATH="/root/.cargo/bin:${PATH}"
ENV NODE_OPTIONS=--max-old-space-size=4096

# Tauri v2 build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libwebkit2gtk-4.1-dev libgtk-3-dev librsvg2-dev patchelf \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
# Build the bundled MCP server + frontend, then the Rust binary (embeds frontend).
RUN npm --prefix mcp-server ci
RUN npm run mcp:build
RUN npm run build
RUN cargo build --release --manifest-path src-tauri/Cargo.toml

# ---------- Runtime stage ----------
FROM node:24-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    libwebkit2gtk-4.1-0 libgtk-3-0 librsvg2-0 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV HOME=/home/agent
WORKDIR /home/agent
COPY --from=build /src/src-tauri/target/release/llm-wiki /app/llm-wiki
COPY --from=build /src/dist /app/dist
ENV LLM_WIKI_HEADLESS=1
ENV LLM_WIKI_BIND_HOST=0.0.0.0
ENV RUST_BACKTRACE=1
EXPOSE 19828
ENTRYPOINT ["/app/llm-wiki"]
